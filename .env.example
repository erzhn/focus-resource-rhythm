# ============================================================================
# «Фокус — Ресурс — Ритм» — пример переменных окружения.
# Скопируйте в .env.local и заполните. Секреты в репозиторий не коммитятся.
# Без переменных Supabase приложение работает в ДЕМО-РЕЖИМЕ (данные в памяти).
# ============================================================================

# --- Supabase (обязательно для реального хранения, RLS и авторизации) ---
# Публичные значения (безопасны для клиента):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только сервер. НИКОГДА не попадает в клиентский бандл:
SUPABASE_SERVICE_ROLE_KEY=

# --- Шифрование OAuth refresh-токенов (только сервер) ---
# 32-байтовый ключ (base64). Токены календарей хранятся зашифрованными.
TOKEN_ENCRYPTION_KEY=

# --- Google Calendar OAuth (Этап 6; без ключей интеграция не активируется) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Microsoft Graph OAuth ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# --- Публичный базовый URL (для webhook-ов синхронизации календарей) ---
APP_BASE_URL=http://localhost:3000

# --- Необязательный AI-провайдер для помощника формулировки ---
# Отсутствие ключа НЕ ломает основной сценарий (работает шаблонный помощник).
AI_PROVIDER=
AI_API_KEY=
