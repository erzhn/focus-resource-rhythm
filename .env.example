# ============================================================================
# «Фокус — Ресурс — Ритм» — пример переменных окружения.
# Скопируйте в .env.local и заполните. Секреты в репозиторий не коммитятся.
# Без переменных Supabase приложение работает в ДЕМО-РЕЖИМЕ (данные в памяти).
# ============================================================================

# --- Supabase (обязательно для реального хранения, RLS и авторизации) ---
# Публичные значения (безопасны для клиента):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Только сервер. НИКОГДА не попадает в клиентский бандл:
SUPABASE_SERVICE_ROLE_KEY=

# --- Шифрование OAuth refresh-токенов (только сервер) ---
# 32-байтовый ключ (base64). Токены календарей хранятся зашифрованными.
TOKEN_ENCRYPTION_KEY=

# --- Google Calendar OAuth (Этап 6; без ключей интеграция не активируется) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Адрес возврата вычисляется автоматически из APP_BASE_URL (или домена Vercel).
# Задавайте эту переменную, только если нужен нестандартный адрес.
GOOGLE_REDIRECT_URI=

# --- Microsoft Graph OAuth ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# --- Публичный базовый URL ---
# Используется для webhook-ов синхронизации И для адреса возврата OAuth.
# На Vercel можно не задавать — домен определится автоматически.
APP_BASE_URL=http://localhost:3000

# --- AI-ассистент ---
# Провайдеры образуют ЦЕПОЧКУ с автоматическим запасным вариантом: если основной
# не ответил (кончилась квота, сервис недоступен), запрос уходит следующему с ключом.
# Порядок по умолчанию: gemini -> groq -> anthropic -> ollama (локальный, вне облака).
# ASSISTANT_PROVIDER задаёт, кто идёт ПЕРВЫМ; остальные остаются запасными:
#   ASSISTANT_PROVIDER = ollama | gemini | groq | anthropic
# Чтобы фолбэк реально работал, задайте ключи хотя бы двух провайдеров.
# Ключи только на сервере, в клиент не попадают.
ASSISTANT_PROVIDER=
# Переопределить модель (иначе разумная по умолчанию для провайдера).
ASSISTANT_MODEL=

# Ollama — БЕСПЛАТНО, локально. Установить: https://ollama.com → `ollama run llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini — бесплатный тариф. Ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — бесплатный тариф. Ключ: https://console.groq.com/keys
GROQ_API_KEY=

# Claude (Anthropic) — платно. Ключ: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=

# Примечание: «помощник формулировки задачи» в форме добавления работает на
# встроенных шаблонах и внешний ИИ-ключ ему не нужен.

# --- Защита проекта Supabase от засыпания ---
# Бесплатный тариф ставит проект на паузу после недели без обращений.
# vercel.json запускает /api/keep-alive раз в сутки; этот секрет защищает адрес
# от посторонних (Vercel подставляет его в заголовок Authorization автоматически).
CRON_SECRET=
